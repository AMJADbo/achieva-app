NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/achieva

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production

# Web URL (CORS)
WEB_URL=http://localhost:3000

# Cloudflare R2
R2_BUCKET=achieva-media
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://media.achieva.app
